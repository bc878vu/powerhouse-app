rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/powerhouse_users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    match /powerhouse_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // A user may bootstrap only their own profile, and new self-created
      // profiles are always low-privilege. Admins can create staff profiles.
      allow create: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.role == 'electrician');

      // Users may update their own profile fields, but cannot promote
      // themselves or change their account status. Admins retain full control.
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status);

      allow delete: if isAdmin();
    }

    match /powerhouse_panels/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /powerhouse_panel_routes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /powerhouse_panel_history/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /powerhouse_machines/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /entries/{id} {
      allow read, write: if signedIn();
    }

    match /powerhouse_fcm_tokens/{uid} {
      allow read, write: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /powerhouse_notifications/{uid}/items/{notificationId} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /tasks/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    match /activities/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    match /duties/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    match /tools/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
