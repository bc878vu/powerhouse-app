rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================================================
    // AUTH / ROLE HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn()
        ? request.auth.token.email
        : '';
    }

    function isAdminEmail() {
      return signedIn()
        && (
          userEmail() == 'admin@powerhouse.com' ||
          userEmail() == 'Admin@powerhouse.com'
        );
    }

    function isAdminProfile() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/powerhouse_users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/powerhouse_users/$(request.auth.uid)
        ).data.role in ['admin', 'superadmin'];
    }

    function isAdmin() {
      return isAdminEmail() || isAdminProfile();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function safeUserRole() {
      return request.resource.data.role
        in ['electrician', 'staff', 'cro'];
    }


    // =========================================================
    // USERS
    // =========================================================

    match /powerhouse_users/{uid} {

      // User can see own profile.
      // Admin can see all profiles.
      allow read: if isOwner(uid) || isAdmin();

      // Admin can create users.
      // User can create own profile with safe role/status.
      allow create: if
        isAdmin()
        ||
        (
          isOwner(uid)
          && request.resource.data.uid == uid
          && safeUserRole()
          && request.resource.data.status == 'active'
        );

      // Admin can modify everything.
      // User cannot change own UID, role or status.
      allow update: if
        isAdmin()
        ||
        (
          isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        );

      // Only admin can delete users.
      allow delete: if isAdmin();
    }


    // =========================================================
    // PUBLIC OPERATIONAL MONITOR DATA
    // =========================================================

    match /powerhouse_panels/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_panel_routes/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_panel_history/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_machines/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_machine_load_logs/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_machine_categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // FUEL / ENTRIES
    // =========================================================

    match /entries/{id} {

      // Existing app functionality:
      // public monitoring/read access.
      allow read: if true;

      // Only authenticated users can write.
      allow create, update, delete: if signedIn();
    }


    // =========================================================
    // FCM PUSH TOKENS
    // =========================================================
    //
    // IMPORTANT:
    // App may use a device/token ID as Firestore document ID.
    //
    // Expected token document can contain:
    //
    // {
    //   userId: "firebase-auth-uid",
    //   token: "...",
    //   ...
    // }
    //
    // Ownership is checked using userId instead of assuming
    // document ID == Firebase Auth UID.
    //
    // This is the important change for the notification system.
    // =========================================================

    match /powerhouse_fcm_tokens/{tokenId} {

      // Admin can read all token documents.
      // User can read only own token document.
      allow read: if
        isAdmin()
        ||
        (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      // Admin can create any token.
      // Normal user can only register a token belonging to itself.
      allow create: if
        isAdmin()
        ||
        (
          signedIn()
          && request.resource.data.userId == request.auth.uid
        );

      // Admin can update any token.
      // User can update only own token and cannot transfer ownership.
      allow update: if
        isAdmin()
        ||
        (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
        );

      // Admin can delete any token.
      // User can remove only own token.
      allow delete: if
        isAdmin()
        ||
        (
          signedIn()
          && resource.data.userId == request.auth.uid
        );
    }


    // =========================================================
    // USER NOTIFICATIONS
    // =========================================================

    match /powerhouse_notifications/{uid}/items/{notificationId} {

      // User sees own notifications.
      // Admin sees all notifications.
      allow read: if isOwner(uid) || isAdmin();

      // User/admin can create notification.
      allow create: if isOwner(uid) || isAdmin();

      // User/admin can update notification.
      // Used for mark-read functionality.
      allow update: if isOwner(uid) || isAdmin();

      // Only admin can delete notification records.
      allow delete: if isAdmin();
    }


    // =========================================================
    // ALERT EVENTS
    // =========================================================

    match /powerhouse_alert_events/{eventId} {

      // Existing admin alert-management functionality.
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }


    // =========================================================
    // TASK NUMBER COUNTER
    // =========================================================
    //
    // Required by the client-side task numbering transaction.
    // =========================================================

    match /system_counters/{id} {

      allow read, write: if signedIn();
    }


    // =========================================================
    // TASKS
    // =========================================================

    match /tasks/{id} {

      // Existing application requires authenticated task access.
      allow read, write: if signedIn();
    }


    // =========================================================
    // ACTIVITIES
    // =========================================================

    match /activities/{id} {

      allow read, write: if signedIn();
    }


    // =========================================================
    // DUTIES
    // =========================================================

    match /duties/{id} {

      allow read, write: if signedIn();
    }


    // =========================================================
    // TOOLS
    // =========================================================

    match /tools/{id} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // CATEGORIES
    // =========================================================

    match /categories/{id} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================
    //
    // Any collection not explicitly listed above is blocked.
    // =========================================================

    match /{document=**} {

      allow read, write: if false;
    }
  }
}
