rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return signedIn() ? request.auth.token.email : ''; }
    function isAdminEmail() { return signedIn() && (email() == 'admin@powerhouse.com' || email() == 'Admin@powerhouse.com'); }
    function isAdminProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/powerhouse_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/powerhouse_users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }
    function isAdmin() { return isAdminEmail() || isAdminProfile(); }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function safeUserRole() { return request.resource.data.role in ['electrician', 'staff', 'cro']; }

    match /powerhouse_users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || (isOwner(uid) && request.resource.data.uid == uid && safeUserRole() && request.resource.data.status == 'active');
      allow update: if isAdmin() || (isOwner(uid) && request.resource.data.uid == uid && request.resource.data.role == resource.data.role && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // Public visitor monitor: read-only operational datasets.
    // No unauthenticated visitor can create, update or delete anything.
    match /powerhouse_panels/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /powerhouse_panel_routes/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /powerhouse_panel_history/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /powerhouse_machines/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /powerhouse_machine_load_logs/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /powerhouse_machine_categories/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /entries/{id} { allow read: if true; allow create, update, delete: if signedIn(); }

    match /powerhouse_fcm_tokens/{uid} { allow read, write: if isOwner(uid) || isAdmin(); }
    match /powerhouse_notifications/{uid}/items/{notificationId} { allow read, create, update: if isOwner(uid) || isAdmin(); allow delete: if isAdmin(); }
    match /powerhouse_alert_events/{eventId} { allow read, create, update: if isAdmin(); allow delete: if isAdmin(); }
    match /tasks/{id} { allow read, write: if signedIn(); }
    match /activities/{id} { allow read, write: if signedIn(); }
    match /duties/{id} { allow read, write: if signedIn(); }
    match /tools/{id} { allow read: if signedIn(); allow create, update, delete: if isAdmin(); }
    match /categories/{id} { allow read: if signedIn(); allow create, update, delete: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
