rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // AUTH / ROLE HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn() ? request.auth.token.email : '';
    }

    function isAdminEmail() {
      return signedIn()
        && (
          userEmail() == 'admin@powerhouse.com' ||
          userEmail() == 'Admin@powerhouse.com'
        );
    }

    function isAdminProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/powerhouse_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/powerhouse_users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    function isAdmin() {
      return isAdminEmail() || isAdminProfile();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function safeUserRole() {
      return request.resource.data.role in ['electrician', 'staff', 'cro'];
    }

    // =========================================================
    // USERS
    // =========================================================

    match /powerhouse_users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == uid
          && safeUserRole()
          && request.resource.data.status == 'active'
        );

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        );

      allow delete: if isAdmin();
    }

    // =========================================================
    // PUBLIC OPERATIONAL MONITOR DATA
    // =========================================================

    match /powerhouse_panels/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_panel_routes/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_panel_history/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_machines/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_machine_load_logs/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_machine_categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // FUEL / ENTRIES
    // =========================================================

    match /entries/{id} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    // =========================================================
    // WAPDA METER READINGS
    // =========================================================
    // WapdaManagement.jsx uses a realtime listener on this collection.
    // Keep read access public to preserve the existing monitoring/report
    // behavior; writes remain authenticated.

    match /wapdaReadings/{id} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    // =========================================================
    // FUEL REPORT DOWNLOAD AUDIT
    // =========================================================
    // Used when generated/downloaded fuel reports are persisted.

    match /fuelReportDownloads/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // =========================================================
    // FCM PUSH TOKENS
    // =========================================================

    match /powerhouse_fcm_tokens/{tokenId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.userId == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
        );

      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );
    }

    // =========================================================
    // USER NOTIFICATIONS
    // =========================================================

    match /powerhouse_notifications/{uid}/items/{notificationId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================
    // ALERT EVENTS
    // =========================================================

    match /powerhouse_alert_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================
    // TASK NUMBER COUNTER
    // =========================================================

    match /system_counters/{id} {
      allow read, write: if signedIn();
    }

    // =========================================================
    // TASKS
    // =========================================================

    match /tasks/{id} {
      allow read, write: if signedIn();
    }

    // =========================================================
    // ACTIVITIES
    // =========================================================

    match /activities/{id} {
      allow read, write: if signedIn();
    }

    // =========================================================
    // DUTIES
    // =========================================================

    match /duties/{id} {
      allow read, write: if signedIn();
    }

    // =========================================================
    // TOOLS
    // =========================================================

    match /tools/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // CATEGORIES
    // =========================================================

    match /categories/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
