rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // AUTH / SECURITY HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn()
        && request.auth.token.email != null
        ? request.auth.token.email
        : '';
    }

    // Existing admin email compatibility
    function isAdminEmail() {
      return signedIn()
        && userEmail().lower() == 'admin@powerhouse.com'
        && exists(/databases/$(database)/documents/powerhouse_users/$(request.auth.uid))
        && !(
          get(/databases/$(database)/documents/powerhouse_users/$(request.auth.uid))
            .data.get('status', 'active') in ['inactive', 'blocked']
        );
    }

    // Role based admin / superadmin
    function isAdminProfile() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/powerhouse_users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/powerhouse_users/$(request.auth.uid)
        ).data.role in ['admin', 'superadmin']
        && !(
          get(/databases/$(database)/documents/powerhouse_users/$(request.auth.uid))
            .data.get('status', 'active') in ['inactive', 'blocked']
        );
    }

    function isAdmin() {
      return isAdminEmail() || isAdminProfile();
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/powerhouse_users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/powerhouse_users/$(request.auth.uid)
        ).data.role == 'superadmin'
        && !(
          get(/databases/$(database)/documents/powerhouse_users/$(request.auth.uid))
            .data.get('status', 'active') in ['inactive', 'blocked']
        );
    }

    function isOwner(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    // Prevent self-registration as admin
    function safeUserRole() {
      return request.resource.data.role in [
        'electrician',
        'staff',
        'cro'
      ];
    }

    function validUserStatus() {
      return request.resource.data.status in [
        'active',
        'inactive',
        'pending',
        'blocked'
      ];
    }


    // =========================================================
    // USERS
    // =========================================================

    match /powerhouse_users/{uid} {

      allow read: if isOwner(uid) || isAdmin();

      allow create: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == uid
          && safeUserRole()
          && validUserStatus()
          && request.resource.data.status == 'active'
        );

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          // A user may edit profile details, but cannot change identity fields.
          // Administrative identity changes must go through an admin workflow.
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasNone(['uid', 'id', 'numericId', 'firebaseUid', 'email', 'employeeID', 'role', 'status'])
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // PUBLIC OPERATIONAL DATA
    // Public can view, only admin can modify
    // =========================================================

    match /powerhouse_panels/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_panel_routes/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_panel_history/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_machines/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_machine_load_logs/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_machine_categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // GLOBAL POWERHOUSE SETTINGS
    //
    // IMPORTANT:
    // Public can read operational settings because Public Dashboard
    // needs diesel threshold / alert status.
    //
    // Only admin can change settings.
    // =========================================================

    match /powerhouse_settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // PUBLIC ALERT STATE
    //
    // Example:
    // powerhouse_alert_state/current
    //
    // Public dashboard can read current diesel alert.
    // Only admin writes directly.
    // For automatic alert events, Cloud Functions/Admin SDK bypass
    // Firestore client rules securely.
    // =========================================================

    match /powerhouse_alert_state/{alertId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // PUBLIC OPERATIONAL STATUS
    // =========================================================

    match /powerhouse_public_status/{statusId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // FUEL / ENTRIES
    //
    // Existing behavior preserved:
    // Public read + authenticated CRUD.
    // =========================================================

    match /entries/{id} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }


    // =========================================================
    // ENGINE SERVICE LOGS
    // =========================================================

    match /engineServiceLogs/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }


    // =========================================================
    // WAPDA METER READINGS
    // =========================================================

    match /wapdaReadings/{id} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }


    // =========================================================
    // FUEL REPORT DOWNLOAD AUDIT
    // =========================================================

    match /fuelReportDownloads/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }


    // =========================================================
    // FCM PUSH TOKENS
    //
    // User can only manage own token.
    // Admin can manage all tokens.
    // Token owner cannot be changed during update.
    // =========================================================

    match /powerhouse_fcm_tokens/{tokenId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.userId == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.userId == request.auth.uid
        );

      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );
    }


    // =========================================================
    // OPTIONAL PUBLIC / ANONYMOUS FCM TOKENS
    //
    // IMPORTANT:
    // This collection is ONLY for device tokens.
    // Do NOT store passwords, CNIC, emails or sensitive data here.
    //
    // Recommended document structure:
    // powerhouse_public_fcm_tokens/{tokenHash}
    //
    // Public devices can create their own token record.
    // They cannot list/read all tokens.
    // Updates/deletes require the same installationId.
    //
    // For strongest protection, use a Cloud Function/API instead
    // of direct client writes.
    // =========================================================

    match /powerhouse_public_fcm_tokens/{tokenId} {

      // No public listing of all device tokens
      allow read: if isAdmin();

      // Allows public device registration only when an installation ID
      // and token are present.
      // Limit unauthenticated payload size and disallow unexpected fields.
      // This reduces abuse; installationId remains an untrusted client identifier.
      allow create: if
        request.resource.data.keys().hasAll(['token', 'installationId'])
        && request.resource.data.keys().hasOnly(['token', 'installationId', 'createdAt', 'updatedAt', 'platform'])
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 20
        && request.resource.data.token.size() <= 4096
        && request.resource.data.installationId is string
        && request.resource.data.installationId.size() >= 8
        && request.resource.data.installationId.size() <= 256;

      // Keep the same installation ID and apply the same field/size limits.
      allow update: if
        resource.data.installationId == request.resource.data.installationId
        && request.resource.data.keys().hasOnly(['token', 'installationId', 'createdAt', 'updatedAt', 'platform'])
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 20
        && request.resource.data.token.size() <= 4096
        && request.resource.data.installationId is string
        && request.resource.data.installationId.size() >= 8
        && request.resource.data.installationId.size() <= 256;

      // Public deletion is intentionally disabled.
      // Admin or backend cleanup handles expired tokens.
      allow delete: if isAdmin();
    }


    // =========================================================
    // USER NOTIFICATIONS
    // =========================================================

    match /powerhouse_notifications/{uid}/items/{notificationId} {

      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid) || isAdmin();

      allow update: if isOwner(uid) || isAdmin();

      allow delete: if isAdmin();
    }


    // =========================================================
    // GLOBAL ALERT EVENTS
    //
    // Sensitive alert audit/history.
    // Admin only from client.
    // Cloud Functions/Admin SDK can securely write automatically.
    // =========================================================

    match /powerhouse_alert_events/{eventId} {
      allow read, create, update, delete: if isAdmin();
    }


    // =========================================================
    // ALERT DELIVERY / PUSH JOB STATE
    //
    // Internal backend-controlled state.
    // No client access.
    //
    // Cloud Functions / Firebase Admin SDK bypass these rules.
    // =========================================================

    match /powerhouse_alert_delivery/{id} {
      allow read, write: if false;
    }

    match /powerhouse_alert_jobs/{id} {
      allow read, write: if false;
    }


    // =========================================================
    // SYSTEM COUNTERS
    // Existing behavior preserved
    // =========================================================

    match /system_counters/{id} {
      // Counters coordinate shared identifiers; ordinary staff must not alter them.
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // TASKS / COMPLAINTS
    //
    // Public Dashboard:
    // Read/list/view only.
    //
    // Logged-in users:
    // Existing CRUD preserved.
    // =========================================================

    // Only existing assignees may perform workflow/status updates.
    // Admins retain full task editing and reassignment controls.
    function isAssignedTask(task) {
      return signedIn() && (
        (task.get('assigned_user_ids', []) is list && request.auth.uid in task.get('assigned_user_ids', [])) ||
        (task.get('user_ids', []) is list && request.auth.uid in task.get('user_ids', [])) ||
        task.get('user_id', '') == request.auth.uid
      );
    }

    function isStaffTaskUpdate() {
      return isAssignedTask(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignment_history', 'assignment_cycle', 'updated_at',
          'accepted_at', 'completed_at', 'rejected_at', 'rejection_reason',
          'completion_reports', 'latest_completion'
        ])
        // Assignees cannot change the cycle or edit assignment identity.
        && request.resource.data.get('assignment_cycle', 1) == resource.data.get('assignment_cycle', 1);
    }

    match /tasks/{id} {
      allow read: if true;
      // Keep creation available for legacy authenticated complaint flows.
      allow create: if signedIn();
      allow update: if isAdmin() || isStaffTaskUpdate();
      allow delete: if isAdmin();
    }


    // =========================================================
    // ACTIVITIES
    // =========================================================

    match /activities/{id} {
      // Append-only audit events for staff; only admins can correct or remove.
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }


    // =========================================================
    // DUTIES
    // =========================================================

    // Legacy duty documents may use an immutable numeric staff identifier
    // instead of a Firebase UID. Resolve it from the caller's own staff profile,
    // never from client-controlled request fields alone.
    function dutyOwner(staffId) {
      return signedIn() && (
        staffId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/powerhouse_users/$(request.auth.uid))
          && !(
            get(/databases/$(database)/documents/powerhouse_users/$(request.auth.uid))
              .data.get('status', 'active') in ['blocked', 'inactive']
          )
          && (
            staffId == get(/databases/$(database)/documents/powerhouse_users/$(request.auth.uid)).data.get('id', null) ||
            staffId == get(/databases/$(database)/documents/powerhouse_users/$(request.auth.uid)).data.get('numericId', null) ||
            staffId == get(/databases/$(database)/documents/powerhouse_users/$(request.auth.uid)).data.get('employeeID', null)
          )
        )
      );
    }

    match /duties/{id} {
      // Staff can mark their own status; shifts and other users' records
      // require an administrator. Existing duty reads remain available.
      allow read: if signedIn();
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.get('record_type', '') == 'status'
        && dutyOwner(request.resource.data.get('user_id', ''))
        && id == request.resource.data.get('user_id', '') + '_' + request.resource.data.get('duty_date', '')
      );
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.get('record_type', '') == 'status'
        && dutyOwner(resource.data.get('user_id', ''))
        && request.resource.data.get('user_id', '') == resource.data.get('user_id', '')
        && request.resource.data.get('record_type', '') == 'status'
        && request.resource.data.get('duty_date', '') == resource.data.get('duty_date', '')
      );
      allow delete: if isAdmin();
    }


    // =========================================================
    // TOOLS
    // =========================================================

    match /tools/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // CATEGORIES
    // =========================================================

    match /categories/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // DEFAULT DENY
    //
    // Any unknown collection is blocked.
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
