rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // AUTH / SECURITY HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn()
        && request.auth.token.email != null
        ? request.auth.token.email
        : '';
    }

    // Existing admin email compatibility
    function isAdminEmail() {
      return signedIn()
        && (
          userEmail() == 'admin@powerhouse.com' ||
          userEmail() == 'Admin@powerhouse.com'
        );
    }

    // Role based admin / superadmin
    function isAdminProfile() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/powerhouse_users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/powerhouse_users/$(request.auth.uid)
        ).data.role in ['admin', 'superadmin'];
    }

    function isAdmin() {
      return isAdminEmail() || isAdminProfile();
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/powerhouse_users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/powerhouse_users/$(request.auth.uid)
        ).data.role == 'superadmin';
    }

    function isOwner(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    // Prevent self-registration as admin
    function safeUserRole() {
      return request.resource.data.role in [
        'electrician',
        'staff',
        'cro'
      ];
    }

    function validUserStatus() {
      return request.resource.data.status in [
        'active',
        'inactive',
        'pending',
        'blocked'
      ];
    }


    // =========================================================
    // USERS
    // =========================================================

    match /powerhouse_users/{uid} {

      allow read: if isOwner(uid) || isAdmin();

      allow create: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == uid
          && safeUserRole()
          && validUserStatus()
          && request.resource.data.status == 'active'
        );

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // PUBLIC OPERATIONAL DATA
    // Public can view, only admin can modify
    // =========================================================

    match /powerhouse_panels/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_panel_routes/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_panel_history/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_machines/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_machine_load_logs/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_machine_categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // GLOBAL POWERHOUSE SETTINGS
    //
    // IMPORTANT:
    // Public can read operational settings because Public Dashboard
    // needs diesel threshold / alert status.
    //
    // Only admin can change settings.
    // =========================================================

    match /powerhouse_settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // PUBLIC ALERT STATE
    //
    // Example:
    // powerhouse_alert_state/current
    //
    // Public dashboard can read current diesel alert.
    // Only admin writes directly.
    // For automatic alert events, Cloud Functions/Admin SDK bypass
    // Firestore client rules securely.
    // =========================================================

    match /powerhouse_alert_state/{alertId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // PUBLIC OPERATIONAL STATUS
    // =========================================================

    match /powerhouse_public_status/{statusId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // FUEL / ENTRIES
    //
    // Existing behavior preserved:
    // Public read + authenticated CRUD.
    // =========================================================

    match /entries/{id} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }


    // =========================================================
    // ENGINE SERVICE LOGS
    // =========================================================

    match /engineServiceLogs/{id} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }


    // =========================================================
    // WAPDA METER READINGS
    // =========================================================

    match /wapdaReadings/{id} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }


    // =========================================================
    // FUEL REPORT DOWNLOAD AUDIT
    // =========================================================

    match /fuelReportDownloads/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }


    // =========================================================
    // FCM PUSH TOKENS
    //
    // User can only manage own token.
    // Admin can manage all tokens.
    // Token owner cannot be changed during update.
    // =========================================================

    match /powerhouse_fcm_tokens/{tokenId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.userId == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.userId == request.auth.uid
        );

      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );
    }


    // =========================================================
    // OPTIONAL PUBLIC / ANONYMOUS FCM TOKENS
    //
    // IMPORTANT:
    // This collection is ONLY for device tokens.
    // Do NOT store passwords, CNIC, emails or sensitive data here.
    //
    // Recommended document structure:
    // powerhouse_public_fcm_tokens/{tokenHash}
    //
    // Public devices can create their own token record.
    // They cannot list/read all tokens.
    // Updates/deletes require the same installationId.
    //
    // For strongest protection, use a Cloud Function/API instead
    // of direct client writes.
    // =========================================================

    match /powerhouse_public_fcm_tokens/{tokenId} {

      // No public listing of all device tokens
      allow read: if isAdmin();

      // Allows public device registration only when an installation ID
      // and token are present.
      allow create: if
        request.resource.data.keys().hasAll([
          'token',
          'installationId'
        ])
        && request.resource.data.token is string
        && request.resource.data.installationId is string;

      // Anonymous client cannot change token ownership identity.
      allow update: if
        resource.data.installationId == request.resource.data.installationId
        && request.resource.data.installationId is string
        && request.resource.data.token is string;

      // Public deletion is intentionally disabled.
      // Admin or backend cleanup handles expired tokens.
      allow delete: if isAdmin();
    }


    // =========================================================
    // USER NOTIFICATIONS
    // =========================================================

    match /powerhouse_notifications/{uid}/items/{notificationId} {

      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid) || isAdmin();

      allow update: if isOwner(uid) || isAdmin();

      allow delete: if isAdmin();
    }


    // =========================================================
    // GLOBAL ALERT EVENTS
    //
    // Sensitive alert audit/history.
    // Admin only from client.
    // Cloud Functions/Admin SDK can securely write automatically.
    // =========================================================

    match /powerhouse_alert_events/{eventId} {
      allow read, create, update, delete: if isAdmin();
    }


    // =========================================================
    // ALERT DELIVERY / PUSH JOB STATE
    //
    // Internal backend-controlled state.
    // No client access.
    //
    // Cloud Functions / Firebase Admin SDK bypass these rules.
    // =========================================================

    match /powerhouse_alert_delivery/{id} {
      allow read, write: if false;
    }

    match /powerhouse_alert_jobs/{id} {
      allow read, write: if false;
    }


    // =========================================================
    // SYSTEM COUNTERS
    // Existing behavior preserved
    // =========================================================

    match /system_counters/{id} {
      allow read, write: if signedIn();
    }


    // =========================================================
    // TASKS / COMPLAINTS
    //
    // Public Dashboard:
    // Read/list/view only.
    //
    // Logged-in users:
    // Existing CRUD preserved.
    // =========================================================

    match /tasks/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn();
    }


    // =========================================================
    // ACTIVITIES
    // =========================================================

    match /activities/{id} {
      allow read, write: if signedIn();
    }


    // =========================================================
    // DUTIES
    // =========================================================

    match /duties/{id} {
      allow read, write: if signedIn();
    }


    // =========================================================
    // TOOLS
    // =========================================================

    match /tools/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // CATEGORIES
    // =========================================================

    match /categories/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // DEFAULT DENY
    //
    // Any unknown collection is blocked.
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
