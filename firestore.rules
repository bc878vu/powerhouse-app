rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // Authentication helpers
    // ------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return signedIn()
        && (
          request.auth.token.email == 'admin@powerhouse.com'
          || request.auth.token.email == 'Admin@powerhouse.com'
        );
    }

    function isAdminProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/powerhouse_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/powerhouse_users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    function isAdmin() {
      return isAdminEmail() || isAdminProfile();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------
    // User profiles
    // ------------------------------------------------------------
    match /powerhouse_users/{uid} {
      // A user can read their own profile. Admin can read all profiles.
      allow read: if isOwner(uid) || isAdmin();

      // IMPORTANT: Firebase Auth login can succeed before the Firestore
      // profile exists. Allow the authenticated user to create ONLY their
      // own profile. Admin email may bootstrap an admin profile.
      allow create: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == uid
          && (
            request.resource.data.role == 'electrician'
            || request.resource.data.role == 'staff'
          )
        );

      // Users can update their own profile without changing security fields.
      // Admins can update any profile.
      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        );

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // Panels / routes / history
    // ------------------------------------------------------------
    match /powerhouse_panels/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_panel_routes/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /powerhouse_panel_history/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // Machines
    // ------------------------------------------------------------
    match /powerhouse_machines/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // Fuel / generator entries
    // ------------------------------------------------------------
    match /entries/{id} {
      allow read, write: if signedIn();
    }

    // ------------------------------------------------------------
    // FCM tokens
    // ------------------------------------------------------------
    match /powerhouse_fcm_tokens/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ------------------------------------------------------------
    // Notifications
    // ------------------------------------------------------------
    match /powerhouse_notifications/{uid}/items/{notificationId} {
      allow read, create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // Tasks
    // ------------------------------------------------------------
    match /tasks/{id} {
      allow read, write: if signedIn();
    }

    // ------------------------------------------------------------
    // Activities / audit records
    // ------------------------------------------------------------
    match /activities/{id} {
      allow read, write: if signedIn();
    }

    // ------------------------------------------------------------
    // Duties / shifts
    // ------------------------------------------------------------
    match /duties/{id} {
      allow read, write: if signedIn();
    }

    // ------------------------------------------------------------
    // Tools
    // ------------------------------------------------------------
    match /tools/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // Categories
    // ------------------------------------------------------------
    match /categories/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // Default deny: anything not explicitly listed above is blocked.
    // ------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
