# Firebase Admin service account JSON. Keep this private and never put it in frontend VITE_* variables.
FIREBASE_SERVICE_ACCOUNT={}

# Public frontend origin used for FCM click actions.
FRONTEND_URL=https://powerhouse-app-eight.vercel.app

# Existing backend/database settings
PORT=5000

# PowerHouse AI - keep the API key server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_MAX_OUTPUT_TOKENS=1200

# WhatsApp Business via Twilio. Use E.164 phone numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+15551234567
ADMIN_WHATSAPP_NUMBERS=+923001234567,+923001234568
PUBLIC_BACKEND_URL=https://powerhouse-app-production.up.railway.app
TWILIO_VALIDATE_SIGNATURE=true

# Optional: a numeric admin user id used as the AI context anchor when an
# administrator sends a WhatsApp message and the sender number is not a user row.
AI_ADMIN_CONTEXT_USER_ID=1
